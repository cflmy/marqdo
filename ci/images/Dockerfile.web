FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright \
    NPM_CONFIG_REGISTRY=https://registry.npmmirror.com \
    MARQDO_BIN=/opt/marqdo/marqdo-3.0.0-rc.5-x86_64-unknown-linux-gnu/marqdo \
    MARQDO_STDLIB_DIR=/opt/marqdo/marqdo-3.0.0-rc.5-x86_64-unknown-linux-gnu/stdlib \
    MARQDO_WEB_TOOL_JSON=/opt/web-tool/tool.json \
    MARQDO_CLI_VERSION=3.0.0-rc.5
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 nodejs npm xz-utils unzip fonts-noto-cjk \
    && npm install -g playwright@1.49.0 \
    && npx playwright install-deps chromium \
    && curl -fsSL --retry 3 -o /tmp/chromium.zip "https://cdn.npmmirror.com/binaries/playwright/builds/chromium/1148/chromium-linux.zip" \
    && mkdir -p /ms-playwright/chromium-1148 \
    && unzip -q /tmp/chromium.zip -d /ms-playwright/chromium-1148 \
    && touch /ms-playwright/chromium-1148/INSTALLATION_COMPLETE \
    && rm /tmp/chromium.zip \
    && rm -rf /var/lib/apt/lists/*
COPY marqdo.tar.gz /tmp/marqdo.tar.gz
COPY marqdo-web-preview.tgz /tmp/web.tgz
RUN mkdir -p /opt/marqdo /opt/web-tool \
    && tar -xzf /tmp/marqdo.tar.gz -C /opt/marqdo \
    && tar -xzf /tmp/web.tgz -C /opt/web-tool --strip-components=1 \
    && rm /tmp/marqdo.tar.gz /tmp/web.tgz \
    && test -x "$MARQDO_BIN" && "$MARQDO_BIN" --version && test -f "$MARQDO_WEB_TOOL_JSON"
