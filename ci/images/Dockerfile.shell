# Shared shell/source-component CI image. Published to the Gitea container
# registry and consumed by component repos by immutable version tag.
#
# It contains the published CLI/Bundle (one pinned release), common test tools
# and the supported glibc baseline (Ubuntu 24.04, glibc 2.39). Repositories do
# not need apt installs, Rust toolchains or archive downloads in their lanes.
FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 python3-venv build-essential ripgrep \
        xz-utils unzip \
    && rm -rf /var/lib/apt/lists/*

COPY marqdo.tar.gz /tmp/marqdo.tar.gz
RUN mkdir -p /opt/marqdo \
    && tar -xzf /tmp/marqdo.tar.gz -C /opt/marqdo \
    && rm /tmp/marqdo.tar.gz

ENV MARQDO_BIN=/opt/marqdo/marqdo-3.0.0-rc.5-x86_64-unknown-linux-gnu/marqdo \
    MARQDO_STDLIB_DIR=/opt/marqdo/marqdo-3.0.0-rc.5-x86_64-unknown-linux-gnu/stdlib \
    MARQDO_CLI_VERSION=3.0.0-rc.5

RUN test -x "$MARQDO_BIN" && "$MARQDO_BIN" --version
