{
  "name": "marqdo",
  "displayName": "Marqdo",
  "description": "Language support for Marqdo (.mq.md) — code as documentation.",
  "version": "0.3.4",
  "publisher": "cflmy",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cflmy/marqdo.git"
  },
  "bugs": {
    "url": "https://github.com/cflmy/marqdo/issues"
  },
  "homepage": "https://github.com/cflmy/marqdo/tree/main/vscode-extension",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "marqdo",
    "markdown",
    "mq.md"
  ],
  "activationEvents": [
    "onLanguage:marqdo",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "marqdo",
        "aliases": [
          "Marqdo",
          "marqdo"
        ],
        "extensions": [
          ".mq.md"
        ],
        "filenamePatterns": [
          "*.mq.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "marqdo",
        "scopeName": "source.marqdo",
        "path": "./syntaxes/marqdo.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "marqdo.run",
        "title": "Run File",
        "shortTitle": "Run",
        "category": "Marqdo",
        "icon": "$(play)"
      },
      {
        "command": "marqdo.view",
        "title": "Open View",
        "shortTitle": "View",
        "category": "Marqdo",
        "icon": "$(open-preview)"
      },
      {
        "command": "marqdo.debug",
        "title": "Open Debugger",
        "shortTitle": "Debug",
        "category": "Marqdo",
        "icon": "$(debug-alt)"
      },
      {
        "command": "marqdo.view.stop",
        "title": "Stop View",
        "category": "Marqdo",
        "icon": "$(close)"
      },
      {
        "command": "marqdo.debug.stop",
        "title": "Stop Debugger",
        "shortTitle": "Stop Debug",
        "category": "Marqdo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "marqdo.catalog",
        "title": "Generate Catalog",
        "category": "Marqdo",
        "icon": "$(book)"
      },
      {
        "command": "marqdo.showOutput",
        "title": "Show Output",
        "category": "Marqdo",
        "icon": "$(output)"
      },
      {
        "command": "marqdo.installCli",
        "title": "Install / Repair CLI",
        "category": "Marqdo",
        "icon": "$(cloud-download)"
      },
      {
        "command": "marqdo.checkCli",
        "title": "Check CLI Status",
        "category": "Marqdo",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marqdo.run",
          "when": "editorLangId == marqdo || resourceFilename =~ /\\.mq\\.md$/",
          "group": "navigation@90"
        },
        {
          "command": "marqdo.view",
          "when": "editorLangId == marqdo || resourceFilename =~ /\\.mq\\.md$/",
          "group": "navigation@91"
        },
        {
          "command": "marqdo.debug",
          "when": "editorLangId == marqdo || resourceFilename =~ /\\.mq\\.md$/",
          "group": "navigation@92"
        }
      ],
      "commandPalette": [
        {
          "command": "marqdo.run",
          "when": "editorLangId == marqdo || resourceFilename =~ /\\.mq\\.md$/"
        },
        {
          "command": "marqdo.view",
          "when": "editorLangId == marqdo || resourceFilename =~ /\\.mq\\.md$/"
        },
        {
          "command": "marqdo.debug",
          "when": "editorLangId == marqdo || resourceFilename =~ /\\.mq\\.md$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "marqdo.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && editorLangId == marqdo"
      }
    ],
    "configuration": {
      "title": "Marqdo",
      "properties": {
        "marqdo.cliPath": {
          "type": "string",
          "default": "marqdo",
          "description": "Path to the marqdo CLI executable (default: marqdo on PATH, or extension-managed install)."
        },
        "marqdo.managedCliPath": {
          "type": "string",
          "default": "",
          "description": "Path written by Marqdo: Install / Repair CLI (managed binary)."
        },
        "marqdo.libPath": {
          "type": "string",
          "default": "",
          "description": "Standard library root (sets MARQDO_LIB when spawning the CLI)."
        },
        "marqdo.autoInstall.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "On startup, detect missing/outdated CLI or missing stdlib and offer install from GitHub Releases."
        },
        "marqdo.minCliVersion": {
          "type": "string",
          "default": "0.1.2",
          "description": "Minimum required Marqdo CLI version (semver). Older installs trigger an upgrade prompt."
        },
        "marqdo.autoInstall.checkUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Periodically check GitHub Releases for newer CLI / extension versions."
        },
        "marqdo.diagnoseOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run `marqdo run` on save to refresh Problems (may hang on interactive input)."
        },
        "marqdo.runTimeoutMs": {
          "type": "number",
          "default": 60000,
          "description": "Timeout for `marqdo run` / diagnose (milliseconds)."
        },
        "marqdo.viewHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host for `marqdo view`."
        },
        "marqdo.viewPort": {
          "type": "number",
          "default": 7429,
          "description": "Port for `marqdo view`."
        },
        "marqdo.viewOpen": {
          "type": "string",
          "enum": [
            "external",
            "simpleBrowser"
          ],
          "default": "external",
          "description": "How to open the view UI after starting the server."
        },
        "marqdo.debugHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host for `marqdo debug`."
        },
        "marqdo.debugPort": {
          "type": "number",
          "default": 7430,
          "description": "Port for `marqdo debug`."
        },
        "marqdo.debugOpen": {
          "type": "string",
          "enum": [
            "external",
            "simpleBrowser"
          ],
          "default": "external",
          "description": "How to open the debug UI after starting the server."
        },
        "marqdo.catalogOut": {
          "type": "string",
          "default": ".marqdo",
          "description": "Output directory for `marqdo catalog`."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.mq.md": "marqdo"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
