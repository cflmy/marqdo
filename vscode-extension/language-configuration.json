{
  "comments": {
    "lineComment": null,
    "blockComment": null
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "`", "close": "`" },
    { "open": "*", "close": "*" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["`", "`"],
    ["*", "*"]
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*>\\s+\\S+.*$",
      "action": { "indent": "indent" }
    }
  ]
}
