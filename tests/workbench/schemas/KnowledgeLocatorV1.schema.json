{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marqdo://contracts/KnowledgeLocatorV1",
  "title": "KnowledgeLocatorV1",
  "type": "object",
  "required": ["schema_version", "project_id", "document_id"],
  "properties": {
    "schema": { "const": "KnowledgeLocatorV1" },
    "schema_version": { "const": 1 },
    "project_id": { "type": "string" },
    "document_id": { "type": "string" },
    "source_revision": { "type": ["string", "null"] },
    "generation_id": { "type": ["string", "null"] },
    "artifact_id": { "type": ["string", "null"] },
    "node_id": { "type": ["string", "null"] },
    "relation": { "type": "string" },
    "resolution": {
      "enum": [
        "resolved",
        "stale",
        "unresolved",
        "ambiguous",
        "version_unavailable",
        "unsupported"
      ]
    }
  },
  "additionalProperties": true
}
